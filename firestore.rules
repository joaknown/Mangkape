rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'joannouf@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================================
    // Entity Validation Blueprints
    // =========================================================================
    function isValidMenuItem(data) {
      return data.keys().hasAll([
          'id', 'name', 'category', 'description', 'tastingNotes',
          'priceCents', 'isSeasonal', 'inStock', 'featured',
          'imageKey', 'sortOrder', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'description', 'tastingNotes',
          'priceCents', 'isSeasonal', 'inStock', 'featured',
          'imageKey', 'sortOrder', 'createdAt', 'updatedAt', 'imageUrl'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.category in ['Perfectly Classic', 'Redefined Creation', 'Beyond Coffee', 'Specialty Options', 'Homegrown Signature', 'Blended Drinks'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 260 &&
        data.tastingNotes is string && data.tastingNotes.size() <= 120 &&
        data.priceCents is int && data.priceCents >= 50 && data.priceCents <= 500000 &&
        data.isSeasonal is bool &&
        data.inStock is bool &&
        data.featured is bool &&
        data.imageKey in ['latte', 'matcha', 'coldbrew', 'beans', 'hero'] &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 250000)) &&
        data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'loyaltyPoints',
          'lifetimePoints', 'favoriteOrderId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'loyaltyPoints',
          'lifetimePoints', 'favoriteOrderId', 'createdAt', 'updatedAt',
          'phone', 'address', 'preferredTemp', 'preferredSize', 'preferredMilk'
        ]) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.loyaltyPoints is int && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 100000 &&
        data.lifetimePoints is int && data.lifetimePoints >= 0 && data.lifetimePoints <= 1000000 &&
        data.favoriteOrderId is string && data.favoriteOrderId.size() <= 128 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 160)) &&
        (!('preferredTemp' in data) || data.preferredTemp in ['Hot', 'Iced']) &&
        (!('preferredSize' in data) || data.preferredSize in ['12 oz', '16 oz', '22 oz']) &&
        (!('preferredMilk' in data) || data.preferredMilk in ['Whole Milk', 'Oat Milk (Oatside)', 'Soy Milk (Kirkland)', 'Low Fat Milk', 'Oat Milk', 'Almond Milk', 'None']) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'userId', 'customerName', 'customerEmail',
          'pickupType', 'pickupTime', 'notes', 'items',
          'subtotalCents', 'discountCents', 'totalCents',
          'pointsEarned', 'pointsRedeemed', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'orderNumber', 'userId', 'customerName', 'customerEmail',
          'pickupType', 'pickupTime', 'notes', 'items',
          'subtotalCents', 'discountCents', 'totalCents',
          'pointsEarned', 'pointsRedeemed', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.orderNumber is string && data.orderNumber.size() >= 4 && data.orderNumber.size() <= 20 &&
        isValidId(data.userId) &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 120 &&
        data.pickupType in ['counter', 'patio', 'curbside'] &&
        data.pickupTime is string && data.pickupTime.size() >= 1 && data.pickupTime.size() <= 40 &&
        data.notes is string && data.notes.size() <= 240 &&
        data.items is list && data.items.size() >= 1 && data.items.size() <= 20 &&
        data.items[0] is map &&
        data.items[0].name is string && data.items[0].name.size() >= 1 && data.items[0].name.size() <= 80 &&
        data.items[0].qty is int && data.items[0].qty >= 1 && data.items[0].qty <= 20 &&
        data.items[0].unitPriceCents is int && data.items[0].unitPriceCents >= 50 && data.items[0].unitPriceCents <= 500000 &&
        data.subtotalCents is int && data.subtotalCents >= 50 && data.subtotalCents <= 5000000 &&
        data.discountCents is int && data.discountCents >= 0 && data.discountCents <= 500000 &&
        data.totalCents is int && data.totalCents >= 0 && data.totalCents <= 5000000 &&
        data.pointsEarned is int && data.pointsEarned >= 0 && data.pointsEarned <= 1000 &&
        data.pointsRedeemed is int && data.pointsRedeemed >= 0 && data.pointsRedeemed <= 10000 &&
        data.status in ['received', 'preparing', 'ready', 'completed', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPageStat(data) {
      return data.keys().hasAll(['pageId', 'views', 'uniqueVisitors', 'updatedAt']) &&
        data.keys().hasOnly(['pageId', 'views', 'uniqueVisitors', 'updatedAt']) &&
        data.pageId in ['site-overview', 'home', 'holiday-treats', 'menu', 'story', 'orders', 'location', 'cms'] &&
        data.views is int && data.views >= 0 && data.views <= 100000000 &&
        data.uniqueVisitors is int && data.uniqueVisitors >= 0 && data.uniqueVisitors <= 100000000 &&
        data.updatedAt is timestamp;
    }

    function isValidItemStat(data) {
      return data.keys().hasAll(['itemId', 'loveCount', 'ratingSum', 'ratingCount', 'updatedAt']) &&
        data.keys().hasOnly(['itemId', 'loveCount', 'ratingSum', 'ratingCount', 'updatedAt']) &&
        isValidId(data.itemId) &&
        data.loveCount is int && data.loveCount >= 0 && data.loveCount <= 100000000 &&
        data.ratingSum is int && data.ratingSum >= 0 && data.ratingSum <= 500000000 &&
        data.ratingCount is int && data.ratingCount >= 0 && data.ratingCount <= 100000000 &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'id', 'itemId', 'itemName', 'userId', 'authorName',
          'rating', 'comment', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'itemId', 'itemName', 'userId', 'authorName',
          'rating', 'comment', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.itemId) &&
        data.itemName is string && data.itemName.size() >= 1 && data.itemName.size() <= 80 &&
        isValidId(data.userId) &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 400 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Rules
    // =========================================================================

    // Public café menu catalog; CMS writes restricted to verified admins
    match /menuItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isAdmin() &&
        isValidId(itemId) &&
        isValidMenuItem(incoming()) &&
        incoming().id == itemId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(itemId) &&
        isValidMenuItem(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(itemId);
    }

    // Private customer PII & loyalty profile
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().loyaltyPoints == 50 &&
        incoming().lifetimePoints == 50 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'phone', 'address', 'preferredTemp',
              'preferredSize', 'preferredMilk', 'favoriteOrderId', 'updatedAt'
            ]) &&
            incoming().loyaltyPoints == existing().loyaltyPoints &&
            incoming().lifetimePoints == existing().lifetimePoints
          ) ||
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['loyaltyPoints', 'lifetimePoints', 'updatedAt']) &&
            incoming().loyaltyPoints <= existing().loyaltyPoints + 1000 &&
            incoming().lifetimePoints >= existing().lifetimePoints &&
            incoming().lifetimePoints <= existing().lifetimePoints + 1000
          )
        );
      allow delete: if false;
    }

    // Customer pickup orders & live fulfillment queue
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'received' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            existing().status == 'received' &&
            incoming().status == 'cancelled' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // Trusted Admin RBAC markers (read-only by owner/admin; managed out-of-band)
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // Website & page-level traffic counters (admin-only read/reset; +1 bounded visit recording)
    match /pageStats/{pageId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(pageId) &&
        isValidPageStat(incoming()) &&
        incoming().pageId == pageId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (incoming().views == 1 && incoming().uniqueVisitors >= 0 && incoming().uniqueVisitors <= 1)
        );
      allow update: if isValidId(pageId) &&
        isValidPageStat(incoming()) &&
        incoming().pageId == existing().pageId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['views', 'uniqueVisitors', 'updatedAt']) &&
            incoming().views == existing().views + 1 &&
            incoming().uniqueVisitors >= existing().uniqueVisitors &&
            incoming().uniqueVisitors <= existing().uniqueVisitors + 1
          )
        );
      allow delete: if false;
    }

    // Public customer love reactions & star ratings per menu item
    match /itemStats/{itemId} {
      allow get, list: if true;
      allow create: if isValidId(itemId) &&
        isValidItemStat(incoming()) &&
        incoming().itemId == itemId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            incoming().loveCount >= 0 && incoming().loveCount <= 1 &&
            incoming().ratingCount >= 0 && incoming().ratingCount <= 1 &&
            incoming().ratingSum >= 0 && incoming().ratingSum <= 5
          )
        );
      allow update: if isValidId(itemId) &&
        isValidItemStat(incoming()) &&
        incoming().itemId == existing().itemId &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['loveCount', 'ratingSum', 'ratingCount', 'updatedAt']) &&
            incoming().loveCount >= existing().loveCount - 1 &&
            incoming().loveCount <= existing().loveCount + 1 &&
            incoming().ratingCount >= existing().ratingCount &&
            incoming().ratingCount <= existing().ratingCount + 1 &&
            incoming().ratingSum >= existing().ratingSum &&
            incoming().ratingSum <= existing().ratingSum + 5
          )
        );
      allow delete: if false;
    }

    // Customer coffee item star ratings & comments (public read; verified member create/edit/delete own review)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().id == reviewId &&
        incoming().userId == request.auth.uid &&
        reviewId == (incoming().itemId + '__' + request.auth.uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        incoming().id == existing().id &&
        incoming().itemId == existing().itemId &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['authorName', 'itemName', 'rating', 'comment', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(reviewId) &&
        (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
